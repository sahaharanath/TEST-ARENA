rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSuperAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    function isBranchHead() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'branchhead';
    }
    function isSchoolHead() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'schoolhead';
    }
    function userBranch() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branchId;
    }
    function isOwnBranch(branchId) {
      return isBranchHead() && userBranch() == branchId;
    }
    function isProgram(program) {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.program == program;
    }

    // ---------- Users (profile) ----------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Organisation settings ----------
    match /organisation/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ---------- Branches ----------
    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow create, write, delete: if isSuperAdmin();
    }

    // ---------- Courses ----------
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create, write, delete: if isSuperAdmin();
    }

    // ---------- Packages ----------
    match /packages/{packageId} {
      allow read: if request.auth != null;
      allow create, write, delete: if isSuperAdmin();
    }

    // ---------- Batches ----------
    match /batches/{batchId} {
      allow read: if request.auth != null;
      allow create, write, delete: if isSuperAdmin();
    }

    // ---------- Students ----------
    match /students/{studentId} {
      allow read: if request.auth != null
        && (
          isSuperAdmin()
          || (isBranchHead() && resource.data.branchId == userBranch())
          || (isSchoolHead() && resource.data.program == 'school')
        );
      allow create: if request.auth != null
        && (
          (isSuperAdmin() && resource.data.program == 'youth')
          || (isBranchHead() && resource.data.branchId == userBranch() && resource.data.program == 'youth')
          || (isSchoolHead() && resource.data.program == 'school')
        );
      allow update: if request.auth != null
        && (
          (isSuperAdmin())
          || (isBranchHead() && resource.data.branchId == userBranch() && request.resource.data.branchId == userBranch())
          || (isSchoolHead() && resource.data.program == 'school')
        );
      allow delete: if isSuperAdmin();
    }

    // ---------- Admissions ----------
    match /admissions/{admissionId} {
      allow read: if request.auth != null
        && (
          isSuperAdmin()
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.branchId == userBranch())
          || (isSchoolHead() && false) // school admissions live in schoolAdmissions
        );
      allow create: if request.auth != null
        && (
          isSuperAdmin()
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.branchId == userBranch())
        );
      allow update: if request.auth != null
        && (
          isSuperAdmin()
          || (isBranchHead() && resource.data.branchId == userBranch())
        );
      allow delete: if isSuperAdmin();
    }

    // ---------- Student history ----------
    match /studentHistory/{hid} {
      allow read: if request.auth != null && (isSuperAdmin() || isBranchHead());
      allow create, write: if isSuperAdmin() || isBranchHead();
      allow delete: if isSuperAdmin();
    }

    // ---------- Transactions (Youth payments) ----------
    match /transactions/{txnId} {
      allow read: if request.auth != null
        && (
          isSuperAdmin()
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.branchId == userBranch())
        );
      allow create: if request.auth != null
        && (
          isSuperAdmin()
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.branchId == userBranch())
        );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- School levels ----------
    match /schoolLevels/{levelId} {
      allow read: if request.auth != null;
      allow create, write, delete: if isSuperAdmin();
    }

    // ---------- School admissions ----------
    match /schoolAdmissions/{saId} {
      allow read: if request.auth != null
        && (isSuperAdmin() || isSchoolHead());
      allow create, write: if request.auth != null
        && (isSuperAdmin() || isSchoolHead());
      allow delete: if isSuperAdmin();
    }

    // ---------- School transactions ----------
    match /schoolTransactions/{txnId} {
      allow read: if request.auth != null
        && (isSuperAdmin() || isSchoolHead());
      allow create: if request.auth != null
        && (isSuperAdmin() || isSchoolHead());
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- Student documents metadata ----------
    match /students/{studentId}/documents/{docId} {
      allow read: if request.auth != null
        && (
          isSuperAdmin()
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == userBranch())
          || (isSchoolHead() && get(/databases/$(database)/documents/students/$(studentId)).data.program == 'school')
        );
      allow create: if request.auth != null
        && (
          (isSuperAdmin())
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == userBranch())
          || (isSchoolHead() && get(/databases/$(database)/documents/students/$(studentId)).data.program == 'school')
        );
      allow update: if isSuperAdmin() || (isBranchHead() && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == userBranch());
      allow delete: if isSuperAdmin();
    }

    // ---------- Archives ----------
    match /archives/{archiveId} {
      allow read: if request.auth != null && isSuperAdmin();
      allow create, write: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- Audit log ----------
    match /auditLog/{logId} {
      allow read: if isSuperAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }
  }
}
